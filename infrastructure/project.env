# Per-experiment runtime settings (tracked). Sourced by
# infrastructure/lib/common.sh; also read by scripts/mcf.py,
# scripts/check_pack.py and .mcp.json.
# Plain KEY=value lines only: no quotes, spaces or shell expansions.
#
# Ports: every experiment needs four of its own TCP ports so two experiments
# can run side by side. Pick ports that are free on this host (`ss -ltn`)
# and not used by another experiment; if your host keeps a port inventory,
# record them there first. The scripts refuse to start anything while a
# port is blank. See README.md "Starting an
# experiment" and AGENTS.md "Ports".

# Dev server game port (binds *; LAN players join here).
GAME_PORT=
# `packwiz serve` pack host for the owner's Prism client (binds *).
SERVE_PORT=
# MCPFabric bridge inside the dev server (binds 127.0.0.1).
SERVER_BRIDGE_PORT=
# MCPFabric bridge inside the headless client (binds 127.0.0.1).
CLIENT_BRIDGE_PORT=

# LAN address players use for the dev server and pack host.
# Blank: the first address from `hostname -I`.
LAN_HOST=

# Prefix for this experiment's tmux sessions (<prefix>-server, -client,
# -packhost). Blank: pexp-<repo directory name>.
SESSION_PREFIX=
